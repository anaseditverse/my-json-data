{
  "type": "FeatureCollection",
  "name": "Kazakhstan to Russia Oil and Condensate Supply Routes",
  "metadata": {
    "title": "Kazakhstan to Russia Supply Routes (CPC, Atyrau-Samara, KATS, KOTS, and Transneft Connections)",
    "description": "Geospatial (WGS84) and image-pixel route data for all oil and gas condensate supply lines from Kazakhstan to Russia depicted across the two uploaded reference maps.",
    "source_images": [
      {
        "image_id": "image_1_cpc_pumping_stations",
        "filename": "image_043569.jpg",
        "width_px": 1024,
        "height_px": 533,
        "depicts": "Caspian Pipeline Consortium (CPC) route from Tengiz PS and Atyrau PS in Kazakhstan through Astrakhanskaya PS, Komsomolskaya PS, and Kropotkinskaya PS to the Marine Terminal on the Black Sea in Russia."
      },
      {
        "image_id": "image_2_kazakhstan_russia_export_network",
        "filename": "image_043227.jpg",
        "width_px": 986,
        "height_px": 581,
        "depicts": "Six interconnected pipeline corridors linking Kazakhstan's Tengiz and Karachaganak fields to Russian hubs (Orenburg, Samara, Novorossiysk/Sheskharis, Yuzhnaya Ozereyevka, Ust-Luga) and onward to Adamova Zastava."
      }
    ],
    "pipeline_systems": [
      {
        "id": "cpc_pipeline",
        "name": "Caspian Pipeline Consortium (CPC) Pipeline",
        "length_km": 1510,
        "max_discharge_bpd": 1400000,
        "commissioned": 2001,
        "operators": [
          "CPC-K (Kazakhstan)",
          "CPC-R (Russia)"
        ],
        "route": "Tengiz PS -> Atyrau PS -> Astrakhanskaya PS -> Komsomolskaya PS -> Kropotkinskaya PS -> Marine Terminal (Yuzhnaya Ozereyevka / Novorossiysk)",
        "legend_color_image_1": "Dark Blue",
        "legend_color_image_2": "Green"
      },
      {
        "id": "atyrau_samara_pipeline",
        "name": "Atyrau-Samara Pipeline",
        "route": "Atyrau (Kazakhstan) -> Bol. Chagan (Kazakhstan) -> Samara (Russia)",
        "legend_color_image_2": "Yellow"
      },
      {
        "id": "kats_pipeline",
        "name": "Karachaganak-Atyrau Transportation System (KATS)",
        "route": "Karachaganak (Kazakhstan) -> Bol. Chagan (Kazakhstan) -> Atyrau (Kazakhstan, connecting into CPC and Atyrau-Samara)",
        "legend_color_image_2": "Red"
      },
      {
        "id": "kots_pipeline",
        "name": "Karachaganak-Orenburg Transportation System (KOTS)",
        "route": "Karachaganak (Kazakhstan) -> Orenburg Gas Processing Complex (Russia)",
        "legend_color_image_2": "Orange"
      },
      {
        "id": "transneft_pipeline_system",
        "name": "Transneft Pipeline System",
        "route": "Samara (Russia) -> Ust-Luga (Baltic Sea, Russia) and Samara (Russia) -> Novorossiysk / Sheskharis (Black Sea, Russia)",
        "legend_color_image_2": "Cyan / Light Blue"
      },
      {
        "id": "atyrau_samara_adamova_zastava",
        "name": "Atyrau-Samara-Adamova Zastava (Druzhba Transit Route)",
        "route": "Atyrau (Kazakhstan) -> Bol. Chagan (Kazakhstan) -> Samara (Russia) -> Adamova Zastava (Poland/Germany corridor)",
        "legend_color_image_2": "Black"
      }
    ],
